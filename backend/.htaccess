<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. If the request is for an actual file that exists, serve it
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 2. Redirect root to views/index.html (the frontend)
    RewriteRule ^$ views/index.html [L]

    # 3. Everything else goes to public/index.php (the API)
    # But skip if it's already going to public/
    RewriteRule ^((?!public/|views/).*)$ public/index.php/$1 [L]
</IfModule>
